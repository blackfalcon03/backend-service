# ==============================================================
# SDET AI AutoTriage Agent - Environment Configuration
# Copy this file to .env and fill in your credentials.
# Note: .env is git-ignored and should never be committed.
# ==============================================================

# LLM Provider selection: gemini | openai | ollama | mock
LLM_PROVIDER=gemini

# --------------------------------------------------------------
# Google Gemini Configuration (Default)
# Get a free key at: https://aistudio.google.com/
# --------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------
# OpenAI Configuration (Optional)
# --------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------
# Self-Hosted Ollama Configuration (Optional / Local VPN)
# --------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --------------------------------------------------------------
# Live Presentation & Demo Failure Simulation Flag
# Set to 'true' to intentionally inject a regression bug in OrderService
# to demonstrate the AI AutoTriage Agent in real-time.
# --------------------------------------------------------------
SIMULATE_BUG=false
